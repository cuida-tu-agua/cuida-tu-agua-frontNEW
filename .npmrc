# NPM Configuration with Security Protections

# ============================================
# SECURITY
# ============================================

# Bloquea instalación de versiones con vulnerabilidades moderadas o altas
# moderate = bloquea high/critical
# high = bloquea solo critical
audit-level=moderate

# Fuerza que las versiones en package.json sean exactas (no ^, ni ~)
# Ej: 1.0.0 en lugar de ^1.0.0
save-exact=true

# Obliga que Node y npm cumplan con versiones en engines de package.json
engine-strict=true

# ============================================
# PERFORMANCE
# ============================================

# Prefiere usar paquetes en caché local si están disponibles
prefer-offline=true

# No instala versiones de peer dependencies desactualizadas automáticamente
# Requiere que el proyecto sea compatible explícitamente
legacy-peer-deps=false

# ============================================
# INTEGRIDAD Y CONFIABILIDAD
# ============================================

# Siempre genera y verifica package-lock.json
package-lock=true

# Guarda el SHA del package-lock para verificación
ignore-scripts=false

# ============================================
# LOGGING
# ============================================

# Nivel de verbosidad: silent, error, warn, notice, http, timing, info, verbose, silly
loglevel=warn
