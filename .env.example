# ONE project for web and mobile. Every variable here is OPTIONAL in development:
#  - Web: the app calls the services on the same host that served the page (localhost -> localhost:3001, ...).
#  - Phone with Expo: it calls the PC that runs `expo start` (Expo gives the app that address).
# Set them only to force a specific server: a production build, a staging server or a PC that is not the Expo one.
# Write each URL WITHOUT a trailing slash. Never put secrets here: everything EXPO_PUBLIC_* ends up inside the app.
# Production (domain, CORS, EAS variables): see PUBLICACION.md

# ms-iam (auth, profile, admin)
# EXPO_PUBLIC_API_URL=http://192.168.X.X:8080/iam
# ms-places (places, tariffs, tips)
# EXPO_PUBLIC_PLACES_API_URL=http://192.168.X.X:8080/places
# ms-device (meters, HU-012/013/014)
# EXPO_PUBLIC_DEVICES_API_URL=http://192.168.X.X:8080/devices
# ms-consumption (HU-015..018)
# EXPO_PUBLIC_CONSUMPTION_API_URL=http://192.168.X.X:8080/consumption
# ms-valve (HU-019..022)
# EXPO_PUBLIC_VALVE_API_URL=http://192.168.X.X:8080/valve
# ms-notification (inbox, preferences, push)
# EXPO_PUBLIC_NOTIFICATIONS_API_URL=http://192.168.X.X:8080/notifications

# Legal texts (terms, data policy): the contact e-mail and the city of the people responsible.
# They replace the project e-mail (src/config/legal.ts) in a build; without a city the documents show only the country.
# EXPO_PUBLIC_LEGAL_EMAIL=sywater2026@gmail.com
# EXPO_PUBLIC_LEGAL_CITY=Pasto, Colombia
