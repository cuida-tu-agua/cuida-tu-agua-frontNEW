# Copy this file to .env and put the LAN IP of YOUR PC (ipconfig → Wi-Fi → IPv4).
# On a physical phone "localhost" does not work: it would be the phone itself.
# ms-iam (auth)
EXPO_PUBLIC_API_URL=http://192.168.X.X:8081
# ms-places (places)
EXPO_PUBLIC_PLACES_API_URL=http://192.168.X.X:3002
# ms-devices (meters, HU-012/013/014)
EXPO_PUBLIC_DEVICES_API_URL=http://192.168.X.X:3003
# ms-consumption (HU-015..018)
EXPO_PUBLIC_CONSUMPTION_API_URL=http://192.168.X.X:3004
# ms-valve (HU-019..022)
EXPO_PUBLIC_VALVE_API_URL=http://192.168.X.X:3005
