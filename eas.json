{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sy-water.tech/iam",
        "EXPO_PUBLIC_PLACES_API_URL": "https://api.sy-water.tech/places",
        "EXPO_PUBLIC_DEVICES_API_URL": "https://api.sy-water.tech/devices",
        "EXPO_PUBLIC_CONSUMPTION_API_URL": "https://api.sy-water.tech/consumption",
        "EXPO_PUBLIC_VALVE_API_URL": "https://api.sy-water.tech/valve",
        "EXPO_PUBLIC_NOTIFICATIONS_API_URL": "https://api.sy-water.tech/notifications"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.sy-water.tech/iam",
        "EXPO_PUBLIC_PLACES_API_URL": "https://api.sy-water.tech/places",
        "EXPO_PUBLIC_DEVICES_API_URL": "https://api.sy-water.tech/devices",
        "EXPO_PUBLIC_CONSUMPTION_API_URL": "https://api.sy-water.tech/consumption",
        "EXPO_PUBLIC_VALVE_API_URL": "https://api.sy-water.tech/valve",
        "EXPO_PUBLIC_NOTIFICATIONS_API_URL": "https://api.sy-water.tech/notifications"
      }
    }
  }
}